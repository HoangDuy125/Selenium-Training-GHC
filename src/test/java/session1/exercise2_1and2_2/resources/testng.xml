<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Calculator Test Suite"
       parallel="tests"
       thread-count="2">

    <!-- ===== Test 1: Arithmetic group only ===== -->
    <test name="Arithmetic Tests" parallel="methods" thread-count="2">
        <parameter name="a" value="20"/>
        <parameter name="b" value="10"/>

        <groups>
            <run>
                <include name="arithmetic"/>
            </run>
        </groups>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest"/>
        </classes>
    </test>

    <!-- ===== Test 2: Advanced group only ===== -->
    <test name="Advanced Tests" parallel="methods" thread-count="2">
        <parameter name="a" value="50"/>
        <parameter name="b" value="5"/>

        <groups>
            <run>
                <include name="advanced"/>
            </run>
        </groups>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest"/>
        </classes>
    </test>

    <!-- ===== Test 3: Specific method selection ===== -->
    <test name="Specific Method Tests">
        <parameter name="a" value="100"/>
        <parameter name="b" value="20"/>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest">
                <methods>
                    <include name="testAddition"/>
                    <exclude name="testSubtraction"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
